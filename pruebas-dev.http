### 1. Compra con el SKU en minúsculas y con espacios -> entran 5 a U-100
POST http://localhost:8000/dev/events
Content-Type: application/json

{"event_id": "00000000-0000-0000-0000-000000000001", "event_type": "purchase.item_received", "event_version": 1, "occurred_at": "2026-10-09T12:00:00Z", "source": "shop-floor", "key": "PR-1", "data": {"purchase_request_id": 900001, "request_number": "900001", "line_id": 900001, "part_number": "  prueba 9001/x ", "description": "Rodamiento", "quantity": 5, "unit_price": "1850.00", "currency": "MXN", "purpose": "restock", "received_at": "2026-10-09T12:00:00Z", "work_order_code": null}}

